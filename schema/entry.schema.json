{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/skps00/packai-knowledge/schema/entry.schema.json",
  "title": "Pack AI knowledge entry",
  "type": "object",
  "required": ["item", "mod", "applies_to", "contributors", "updated"],
  "additionalProperties": false,
  "properties": {
    "item": { "type": "string", "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$" },
    "display": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "mod": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
    "applies_to": {
      "type": "object",
      "required": ["mc"],
      "additionalProperties": false,
      "properties": {
        "mc": { "type": "string" },
        "loader": { "type": "string", "enum": ["forge", "neoforge", "fabric", "quilt", "any"] },
        "mod_versions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "obtain": { "type": "array", "items": { "$ref": "#/$defs/fact" } },
    "use": { "type": "array", "items": { "$ref": "#/$defs/fact" } },
    "worn": { "type": "array", "items": { "$ref": "#/$defs/fact" } },
    "notes": { "type": "string" },
    "contributors": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "updated": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
  },
  "$defs": {
    "fact": {
      "type": "object",
      "required": ["source", "tier"],
      "additionalProperties": true,
      "properties": {
        "type": { "type": "string" },
        "mob": { "type": "string" },
        "container": { "type": "string" },
        "trigger": { "type": "string" },
        "effect": { "type": "string" },
        "slot": { "type": "string" },
        "effects": { "type": "array", "items": { "type": "string" } },
        "chance": { "type": "string" },
        "requires": { "type": "array", "items": { "type": "object" } },
        "source": { "type": "string", "minLength": 3 },
        "tier": { "type": "string", "enum": ["A", "B", "C"] },
        "conflict": { "type": "boolean" }
      }
    }
  }
}
